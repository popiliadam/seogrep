SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=
SUPABASE_DB_URL=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
# OPTIONAL, and DEFAULTS TO UNSET — leave this line commented out. It decides what the webhook
# does when a purchase's signed attribution token cannot be verified: unset/0/false = grace
# (credit the body's claimed user_id and warn), 1/true = refuse the event (500, no ledger row).
# Enforcement is an operator-supervised mode with real preconditions — read
# scripts/paddle-smoke.md → "Attribution enforcement" before setting it.
# PADDLE_ATTRIBUTION_ENFORCE=
# Client (checkout overlay) — NEXT_PUBLIC_* are exposed to the browser bundle.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# Exactly "sandbox" or "production" — read by BOTH the browser checkout overlay AND the
# server-side Paddle SDK (webhook verification + customer portal). Anything else is ignored:
# the checkout button stays disabled and the server SDK falls back to its own default.
NEXT_PUBLIC_PADDLE_ENV=
# Paddle price ids per package (checkout + webhook price->package mapping).
NEXT_PUBLIC_PADDLE_PRICE_STARTER=
NEXT_PUBLIC_PADDLE_PRICE_PRO=
NEXT_PUBLIC_PADDLE_PRICE_AGENCY=
NEXT_PUBLIC_PADDLE_PRICE_TOPUP_10=
NEXT_PUBLIC_PADDLE_PRICE_TOPUP_25=
NEXT_PUBLIC_PADDLE_PRICE_TOPUP_50=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Live keyword-research switch. research_keywords hits the paid DataForSEO API ONLY when
# this is exactly "1" AND both DATAFORSEO_* are set; unset keeps live OFF (the tool returns
# a clear "not yet enabled" error and charges nothing). Dev-smoke spend is capped at
# $3/day by guardrails/dfs-budget.sh.
DFS_LIVE=
# Google OAuth (GSC) — adlar Netlify prod'la birebir doğrulandı (insan gözü, 2026-07-19)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY=
RESEND_API_KEY=
# RESEND_SEGMENT_ID removed 2026-08-05: it addressed the waitlist audience, and both its
# consumers (lib/waitlist-deps.ts, core resend-store.ts) went with the waitlist. If it is still
# set in a deploy env, clear it there too — a live var with no reader invites the next person to
# assume something still reads it.
# Verified sender for transactional mail (welcome email). Unset => welcome is skipped.
RESEND_FROM_EMAIL=
NEXT_PUBLIC_POSTHOG_KEY=
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
MCP_BASE_URL=
MCP_URL_TEMPLATE=
WEB_BASE_URL=

# --- Bot challenge on the auth forms (OPTIONAL, unset = off) ---------------------------------
# Cloudflare Turnstile site key. Unset and the widget renders nothing, loads no script, and the
# forms send exactly the request shape they sent before it existed (pinned by
# apps/web/app/(auth)/auth-form.test.tsx "with Turnstile unprovisioned").
#
# ENABLING IS TWO STEPS AND BOTH ARE REQUIRED, IN THIS ORDER. Only one ordering is safe, because
# only one of the two half-states is harmless:
#   env set + Supabase off -> the widget renders and sends a token nothing checks. HARMLESS.
#   env unset + Supabase on -> Auth demands a token the page never sends, and rejects everything.
#                              SIGN-IN and PASSWORD RESET go down with signup. OUTAGE.
# So Netlify goes FIRST and Supabase LAST; that path never enters the second state. (This block
# used to list Supabase before Netlify, and following it took the site through the outage state
# on 2026-08-07.) Procedure:
#   1. Cloudflare dashboard -> Turnstile -> create widget, Hostnames must include seogrep.com,
#      Widget Mode "Managed". Copy Site key + Secret key — they look near-identical, label them.
#   2. Set this var to the SITE key in the Netlify deploy env, then TRIGGER A REDEPLOY. Saving the
#      variable alone changes nothing: NEXT_PUBLIC_* is inlined at BUILD time, so the running
#      bundle only picks it up on the next build.
#   3. Only after that deploy is live: Supabase -> Authentication -> Attack Protection ->
#      Enable CAPTCHA protection, provider "Turnstile", paste the SECRET key, Save.
#   4. Verify in a REAL browser, not with curl: open /signup and watch the submit button go from
#      disabled to enabled (that transition IS the token arriving), then sign in on /login.
#      curl can never carry a token, so a tokenless curl returns "captcha_failed" whether the
#      setup is correct or broken — it cannot tell the two apart. An automated/headless browser
#      is no better: Turnstile is built to withhold the token from exactly those.
#   5. Add Cloudflare to the processors list in apps/web/app/(marketing)/privacy/page.tsx and move
#      that page's effective date. Enabling this loads a Cloudflare script on the auth pages, and
#      that section enumerates processors exhaustively — leaving it out makes the policy wrong.
# Roll back by clearing the Supabase toggle FIRST, then this var. That single toggle restores
# sign-in immediately; waiting on a Netlify rebuild instead keeps the outage open for minutes.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
