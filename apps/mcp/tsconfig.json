{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "noEmit": true,
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src"],
  // ONE exclude, and it stays one. `apps/web/scripts/dist-freshness.mjs` MIRRORS this line by
  // hand (`!rel.endsWith(".test.ts")`) to decide which sources must have a compiled counterpart
  // in `dist`; a second pattern here makes the mirror wrong and verify.sh reports the excluded
  // file as "never compiled at all" (measured 2026-09-02, on an attempt to keep `src/test/`
  // scaffolding out of the runtime image). Scaffolding therefore compiles like everything else.
  "exclude": ["src/**/*.test.ts"]
}
